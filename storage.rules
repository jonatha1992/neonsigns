rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública de imágenes del catálogo para que los visitantes las vean.
    // Escritura (subida, modificación, eliminación) restringida solo a usuarios autenticados (admin).
    // Se valida además que sea imagen y tamaño menor a 10MB.
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Denegar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
