rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access for all authenticated and unauthenticated users
    match /gallery_items/{document} {
      allow read: if true;
      // Permitir escritura a cualquier usuario temporalmente para migración (¡NO OLVIDES REVERTIR ESTO!)
      allow write: if true;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null &&
          get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]))
      );
    }

    // Only administrators may access configuration or other protected documents.
    match /config/admins {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}